# Inlined into the client bundle by Metro. Never put a credential behind this prefix.
EXPO_PUBLIC_EXPO_PROJECT_ID=expo_project_id
EXPO_PUBLIC_ASC_APP_ID=app_store_connect_app_id
EXPO_PUBLIC_CROWDIN_DISRIBUTION_HASH=crowdin_distribution_hash

# Sentry DSN is public by design — it ships in the bundle and only permits sending events.
EXPO_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Build-time only, read by app.config.js and sentry-cli. No EXPO_PUBLIC_ prefix, so these
# stay out of the client bundle. Mirror SENTRY_ORG and SENTRY_PROJECT into the EAS
# environment with identical values, or the fingerprint runtime version will diverge.
SENTRY_ORG=your_sentry_org_slug
SENTRY_PROJECT=your_sentry_project_slug

# Credential. Set as an EAS secret and a GitHub Actions secret; never commit it.
# Do not set SENTRY_ALLOW_FAILURE — a build that cannot upload source maps should fail loudly.
SENTRY_AUTH_TOKEN=sntrys_your_org_auth_token
