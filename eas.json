{
  "cli": {
    "version": ">= 16.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal"
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "environment": "development"
    },
    "production": {
      "environment": "production",
      "channel": "production",
      "autoIncrement": true
    },
    "beta": {
      "environment": "production",
      "channel": "beta",
      "distribution": "store",
      "autoIncrement": true
    },
    "internal-testing": {
      "environment": "production",
      "channel": "internal-testing",
      "distribution": "store",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6754097538"
      },
      "android": {
        "track": "production"
      }
    },
    "beta": {
      "ios": {
        "ascAppId": "6754097538",
        "groups": ["Initial Group"]
      },
      "android": {
        "track": "alpha"
      }
    },
    "internal-testing": {
      "ios": {
        "ascAppId": "6754097538"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
